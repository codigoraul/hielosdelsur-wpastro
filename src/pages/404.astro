---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---
<Layout title="Página no encontrada — Hielos del Sur" description="La página que buscas no existe o fue movida." noindex={true}>
  <section style="padding:6rem 0; text-align:center">
    <div class="wrap">
      <p style="font-size:0.75rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#8B7355">Error 404</p>
      <h1 style="font-size:2rem; font-weight:800; color:#141414; margin:1rem 0">Página no encontrada</h1>
      <p style="color:#57534e; margin-bottom:2rem">La página que buscas no existe o fue movida. Revisa nuestro catálogo o contáctanos.</p>
      <a href={`${base}catalogo/`} style="display:inline-block; background:#141414; color:#fff; padding:1rem 2rem; text-decoration:none; font-size:0.8rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; margin-right:1rem">Ver catálogo</a>
      <a href={`${base}contacto/`} style="display:inline-block; border:1px solid #141414; color:#141414; padding:1rem 2rem; text-decoration:none; font-size:0.8rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase">Contacto</a>
    </div>
  </section>
</Layout>
