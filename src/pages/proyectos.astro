---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getGaleria } from '../lib/wordpress.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { items } = await getGaleria('proyectos-realizados');
---

<Layout title="Proyectos Terminados — Hielos del Sur">

  <PageHero titulo="Proyectos Terminados" imagen="/slider/slider-2.jpg" />

  <section style="padding:4rem 0; background:#FAFAFA">
    <div class="wrap">
      {items.length === 0 ? (
        <p style="text-align:center;color:#888;padding:4rem 0">No hay proyectos disponibles aún.</p>
      ) : (
        <div class="proyectos-grid">
          {items.map(p => (
            <a href={`${base}/proyectos/${p.slug}`} class="proyecto-card">
              <div class="proyecto-img-wrap">
                {p.imagen
                  ? <img src={p.imagen} alt={p.titulo} loading="lazy" />
                  : <div class="proyecto-img-placeholder" />
                }
                <div class="proyecto-hover">
                  <span>Ver proyecto →</span>
                </div>
              </div>
              <div class="proyecto-info">
                <h2>{p.titulo}</h2>
                {(p.cliente || p.anio) && (
                  <p class="proyecto-meta">
                    {[p.cliente, p.anio].filter(Boolean).join(' · ')}
                  </p>
                )}
                {p.galeria?.length > 0 && (
                  <p class="proyecto-fotos">{p.galeria.length} foto{p.galeria.length !== 1 ? 's' : ''}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

</Layout>

<style>
  .proyectos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 1024px) {
    .proyectos-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .proyectos-grid { grid-template-columns: 1fr; }
  }

  .proyecto-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 1px 6px rgba(0,0,0,0.07);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .proyecto-card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.13);
    transform: translateY(-3px);
  }

  .proyecto-img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #e8e0d5;
  }
  .proyecto-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .proyecto-card:hover .proyecto-img-wrap img {
    transform: scale(1.05);
  }
  .proyecto-img-placeholder {
    width: 100%;
    height: 100%;
    background: #d6cdc2;
  }

  .proyecto-hover {
    position: absolute;
    inset: 0;
    background: rgba(139, 115, 85, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .proyecto-card:hover .proyecto-hover {
    opacity: 1;
  }
  .proyecto-hover span {
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .proyecto-info {
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .proyecto-info h2 {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1c1917;
    margin: 0 0 0.3rem;
  }
  .proyecto-meta {
    font-size: 0.75rem;
    color: #8B7355;
    font-weight: 600;
    margin: 0 0 0.2rem;
  }
  .proyecto-fotos {
    font-size: 0.7rem;
    color: #999;
    margin: 0;
  }
</style>
