---
interface Props {
  yoastData?: any;
  canonicalURL?: URL | string;
}

const { yoastData, canonicalURL } = Astro.props;

// Si no hay datos de Yoast, no renderizar nada
if (!yoastData) {
  return null;
}

const {
  title: rawTitle,
  description,
  og_title: rawOgTitle,
  og_description,
  og_image,
  og_type,
  twitter_card,
  twitter_title: rawTwitterTitle,
  twitter_description,
  twitter_image,
  robots,
} = yoastData;

// Yoast viene del WordPress headless (/admin): el título trae el nombre del sitio WP
// ("- hielosdelsur-astro", "archivos") y canonical/og:url apuntan a /admin/.
// Se limpia el título y se usa la URL propia de la página como canonical.
function limpiarTitulo(t: string | undefined) {
  if (!t) return t;
  return t
    .replace(/\s+archivos\s*[-–—]\s*hielosdelsur-astro$/i, ' — Hielos del Sur')
    .replace(/\s*[-–—]\s*hielosdelsur-astro$/i, ' — Hielos del Sur');
}
const title = limpiarTitulo(rawTitle);
const og_title = limpiarTitulo(rawOgTitle);
const twitter_title = limpiarTitulo(rawTwitterTitle);
const canonical = canonicalURL ? String(canonicalURL) : undefined;
const og_url = canonical;
---

{title && <title>{title}</title>}
{description && <meta name="description" content={description} />}
{canonical && <link rel="canonical" href={canonical} />}

<!-- Open Graph -->
{og_title && <meta property="og:title" content={og_title} />}
{og_description && <meta property="og:description" content={og_description} />}
{og_type && <meta property="og:type" content={og_type} />}
{og_url && <meta property="og:url" content={og_url} />}
{og_image && og_image[0] && (
  <>
    <meta property="og:image" content={og_image[0].url} />
    {og_image[0].width && <meta property="og:image:width" content={og_image[0].width} />}
    {og_image[0].height && <meta property="og:image:height" content={og_image[0].height} />}
  </>
)}

<!-- Twitter Card -->
{twitter_card && <meta name="twitter:card" content={twitter_card} />}
{twitter_title && <meta name="twitter:title" content={twitter_title} />}
{twitter_description && <meta name="twitter:description" content={twitter_description} />}
{twitter_image && <meta name="twitter:image" content={twitter_image} />}

<!-- Robots -->
{robots && Object.entries(robots).map(([key, value]) => (
  value && <meta name={`robots:${key}`} content={String(value)} />
))}
